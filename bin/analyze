#!/usr/bin/env php
<?php

require __DIR__."/../vendor/autoload.php";

use Thom2503\PhpUnicodeAnalyzer\Analyzer;

if ($argc < 2) {
	echo "Usage: analyze <directory>\n";
	exit(1);
}

$targetDir = $argv[1];

$analyzer = new Analyzer();
$result = $analyzer->analyzeDirectory($targetDir);

foreach ($result as $file => $r) {
	if (count($r) != 0) {
		echo "\033[1;32mFile: $file\033[0m\n";

		foreach ($r as $key => $enum) {
			// padding with 25 chars
			printf("  %-25s => %s\n", $key, $enum->value);
		}
		echo "\n"; 
	}
}